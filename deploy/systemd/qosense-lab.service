[Unit]
Description=QoSense lab (network namespaces, emulated bloated modem, servers)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/qosense.env
ExecStart=/bin/bash /opt/qosense/lab/netns.sh up
ExecStop=/bin/bash /opt/qosense/lab/netns.sh down

[Install]
WantedBy=multi-user.target
