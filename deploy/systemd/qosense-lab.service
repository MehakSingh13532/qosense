[Unit]
Description=QoSense lab (network namespaces, emulated bloated modem, servers)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/qosense.env
ExecStart=/opt/qosense/lab/netns.sh up
ExecStop=/opt/qosense/lab/netns.sh down

[Install]
WantedBy=multi-user.target
